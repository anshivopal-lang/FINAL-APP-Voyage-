# Copy to .env.local for development. Set the same keys in Vercel →
# Project → Settings → Environment Variables for production.
#
# Nothing here is exposed to the browser: none of these are prefixed with
# NEXT_PUBLIC_, so they exist only in the server runtime.
#
# There is no authentication, so there is no auth secret and no OAuth client to
# configure. The app opens straight onto the dashboard as one of four built-in
# accounts (see src/lib/users.ts).

# --- Database ---------------------------------------------------------------
# Any Postgres: Neon, Vercel Postgres, Supabase, or a local server.
# A JSON file cannot be used in production — Vercel's filesystem is read-only
# and each request may hit a different instance.
#
# sslmode=verify-full is kept here because psql, pg_dump and migration tools
# honour it. The application strips sslmode before connecting and decides in
# src/lib/server/ssl.ts instead — leaving it in makes pg warn about the mode
# AND makes it silently discard DATABASE_CA_CERT. Keeping this value means your
# CLI behaves like the app.
DATABASE_URL=postgresql://user:password@host:5432/voyager?sslmode=verify-full

# Only needed when the provider's certificate is not signed by a publicly
# trusted CA. Accepts a file path or the PEM contents inline. On Vercel, paste
# the PEM in — there is no filesystem to put a file on.
#   Neon / Vercel Postgres  publicly trusted, leave this empty
#   Supabase                may need prod-ca-2021.crt from the dashboard
#   AWS RDS                 needs the RDS CA bundle for your region
# DATABASE_CA_CERT=

# Last resort. Encrypts but does NOT authenticate the server, so an attacker
# who can impersonate the database is not detected. Only for a provider that
# publishes no usable CA. Logs a warning on every boot.
# DATABASE_SSL_NO_VERIFY=true
